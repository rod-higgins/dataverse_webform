/**
 * Build the field mapping section.
 */
function dataverse_webform_build_field_mapping_section(&$form, FormStateInterface $form_state, $webform, $config_manager) {
  $dataverse_config = $webform->getThirdPartySetting('dataverse_webform', 'dataverse_config', []);
  $dataverse_config = $config_manager->mergeWithDefaults($dataverse_config);

  $form['third_party_settings']['dataverse_webform']['field_mapping_wrapper'] = [
    '#type' => 'container',
    '#attributes' => ['id' => 'field-mapping-wrapper'],
    '#states' => [
      'visible' => [
        ':input[name="third_party_settings[dataverse_webform][enabled]"]' => ['checked' => TRUE],
      ],
    ],
  ];
  
  $form['third_party_settings']['dataverse_webform']['field_mapping_wrapper']['field_mappings'] = [
    '#type' => 'details',
    '#title' => t('Multi-Entity Field Mapping'),
    '#description' => t('Map webform fields to Dataverse entities and fields. Each webform field can be mapped to any entity.'),
    '#open' => TRUE,
  ];
  
  // Test connection button
  $form['third_party_settings']['dataverse_webform']['field_mapping_wrapper']['test_connection'] = [
    '#type' => 'button',
    '#value' => t('Test Connection & Load Entities'),
    '#ajax' => [
      'callback' => 'dataverse_webform_test_connection_ajax_callback',
      'wrapper' => 'field-mapping-wrapper',
      'progress' => [
        'type' => 'throbber',
        'message' => t('Testing connection...'),
      ],
    ],
    '#states' => [
      'visible' => [
        ':input[name="third_party_settings[dataverse_webform][dataverse_url]"]' => ['filled' => TRUE],
        ':input[name="third_party_settings[dataverse_webform][azure_tenant_id]"]' => ['filled' => TRUE],
      ],
    ],
  ];
  
  // Build field mapping interface
  dataverse_webform_build_field_mapping_table($form, $form_state, $webform, $dataverse_config);
}

/**
 * Build the field mapping table interface.
 */
function dataverse_webform_build_field_mapping_table(&$form, FormStateInterface $form_state, $webform, $dataverse_config) {
  // Get webform elements for mapping with memory check
  $webform_elements = dataverse_webform_get_webform_elements_safe($webform);
  $field_mappings = $dataverse_config['field_mappings'] ?? [];
  
  // Load available entities if configuration is complete
  $entities = dataverse_webform_load_entities_safe($dataverse_config);
  $entity_options = dataverse_webform_build_entity_options($entities);
  
  // Create field mapping table
  dataverse_webform_build_mapping_table_structure($form, $entity_options);
  
  // Populate table rows
  dataverse_webform_populate_mapping_table_rows($form, $webform_elements, $field_mappings, $entities, $dataverse_config);
  
  // Build submission order configuration if entities available
  if (!empty($entities)) {
    dataverse_webform_build_submission_order_config($form, $field_mappings, $entities, $dataverse_config);
  }
  
  // Show appropriate info messages
  dataverse_webform_show_field_mapping_messages($form, $entities, $dataverse_config);
}

/**
 * Get webform elements safely with memory monitoring.
 */
function dataverse_webform_get_webform_elements_safe($webform) {
  // Check memory before processing
  if (memory_get_usage() > DATAVERSE_WEBFORM_MEMORY_THRESHOLD) {
    \Drupal::logger('dataverse_webform')->warning(
      'High memory usage detected before getting webform elements: @memory',
      ['@memory' => memory_get_usage(true)]
    );
  }

  $webform_elements = $webform->getElementsInitializedAndFlattened();
  
  // Monitor memory after processing
  if (memory_get_usage() > DATAVERSE_WEBFORM_MEMORY_THRESHOLD) {
    \Drupal::logger('dataverse_webform')->warning(
      'High memory usage detected after getting webform elements: @memory',
      ['@memory' => memory_get_usage(true)]
    );
  }

  return $webform_elements;
}

/**
 * Load entities safely with error handling.
 */
function dataverse_webform_load_entities_safe($dataverse_config) {
  $entities = [];
  
  if (dataverse_webform_has_complete_config($dataverse_config)) {
    try {
      $dataverse_service = \Drupal::service('dataverse_webform.dataverse_client');
      $entities = $dataverse_service->getEntities($dataverse_config);
    } catch (\Exception $e) {
      \Drupal::messenger()->addWarning(t('Could not load entities: @error', ['@error' => $e->getMessage()]));
    }
  }
  
  return $entities;
}

/**
 * Build entity options array for select elements.
 */
function dataverse_webform_build_entity_options($entities) {
  $entity_options = ['' => t('- Select an entity -')];
  
  foreach ($entities as $entity) {
    $entity_options[$entity['logical_name']] = $entity['display_name'] . ' (' . $entity['logical_name'] . ')';
  }
  
  return $entity_options;
}

/**
 * Build the field mapping table structure.
 */
function dataverse_webform_build_mapping_table_structure(&$form, $entity_options) {
  $form['third_party_settings']['dataverse_webform']['field_mapping_wrapper']['field_mappings']['table'] = [
    '#type' => 'table',
    '#header' => [
      t('Webform Field'),
      t('Target Entity'),
      t('Target Field'),
      t('Transform'),
      t('Required'),
      t('Actions'),
    ],
    '#empty' => t('No webform fields available for mapping.'),
    '#tableselect' => FALSE,
  ];
}

/**
 * Populate the field mapping table rows.
 */
function dataverse_webform_populate_mapping_table_rows(&$form, $webform_elements, $field_mappings, $entities, $dataverse_config) {
  $transform_options = dataverse_webform_get_transform_options();
  $row_count = 0;
  
  foreach ($webform_elements as $element_key => $element) {
    if (dataverse_webform_is_mappable_element($element)) {
      // Find existing mapping for this field
      $existing_mapping = dataverse_webform_find_existing_mapping($field_mappings, $element_key);
      
      // Build table row
      dataverse_webform_build_table_row($form, $element_key, $element, $existing_mapping, $entities, $transform_options, $row_count);
      
      $row_count++;
      
      // Memory check for large forms
      if ($row_count % 50 === 0 && memory_get_usage() > DATAVERSE_WEBFORM_MEMORY_THRESHOLD) {
        \Drupal::logger('dataverse_webform')->warning(
          'High memory usage during field mapping table build at row @row: @memory',
          ['@row' => $row_count, '@memory' => memory_get_usage(true)]
        );
      }
    }
  }
}

/**
 * Build submission order configuration.
 */
function dataverse_webform_build_submission_order_config(&$form, $field_mappings, $entities, $dataverse_config) {
  $form['third_party_settings']['dataverse_webform']['field_mapping_wrapper']['submission_order'] = [
    '#type' => 'details',
    '#title' => t('Entity Submission Order'),
    '#description' => t('Specify the order in which entities should be created. This is important when entities have relationships.'),
    '#open' => FALSE,
  ];
  
  $entities_in_mappings = [];
  foreach ($field_mappings as $mapping) {
    if (!empty($mapping['entity'])) {
      $entities_in_mappings[$mapping['entity']] = $entities[$mapping['entity']]['display_name'] ?? $mapping['entity'];
    }
  }
  
  $form['third_party_settings']['dataverse_webform']['field_mapping_wrapper']['submission_order']['order'] = [
    '#type' => 'checkboxes',
    '#title' => t('Submission Order'),
    '#description' => t('Select and order the entities for submission. Entities will be created in the order specified.'),
    '#options' => $entities_in_mappings,
    '#default_value' => $dataverse_config['submission_order'] ?? array_keys($entities_in_mappings),
  ];
}

/**
 * Get transform options for field mapping.
 */
function dataverse_webform_get_transform_options() {
  return [
    'none' => t('None'),
    'string' => t('String'),
    'number' => t('Number'),
    'boolean' => t('Boolean'),
    'date' => t('Date'),
    'email' => t('Email'),
    'phone' => t('Phone'),
    'url' => t('URL'),
    'json' => t('JSON'),
  ];
}

/**
 * Check if an element is mappable to Dataverse.
 */
function dataverse_webform_is_mappable_element($element) {
  return isset($element['#type']) && 
         !in_array($element['#type'], ['markup', 'processed_text', 'webform_actions', 'container']);
}

/**
 * Find existing mapping for a webform field.
 */
function dataverse_webform_find_existing_mapping($field_mappings, $element_key) {
  foreach ($field_mappings as $mapping) {
    if (($mapping['webform_field'] ?? '') === $element_key) {
      return $mapping;
    }
  }
  return null;
}

/**
 * Build a single table row for field mapping.
 */
function dataverse_webform_build_table_row(&$form, $element_key, $element, $existing_mapping, $entities, $transform_options, $row_count) {
  $form['third_party_settings']['dataverse_webform']['field_mapping_wrapper']['field_mappings']['table'][$row_count] = [
    'webform_field' => [
      '#type' => 'item',
      '#title' => $element['#title'] ?? $element_key,
      '#description' => t('Type: @type', ['@type' => $element['#type']]),
      '#markup' => '<strong>' . ($element['#title'] ?? $element_key) . '</strong><br><small>' . $element_key . '</small>',
    ],
    'entity' => [
      '#type' => 'select',
      '#options' => dataverse_webform_build_entity_options($entities),
      '#default_value' => $existing_mapping['entity'] ?? '',
      '#ajax' => [
        'callback' => 'dataverse_webform_entity_change_ajax_callback',
        'wrapper' => "field-wrapper-{$row_count}",
        'method' => 'replace',
      ],
      '#attributes' => [
        'data-webform-field' => $element_key,
        'data-row-index' => $row_count,
      ],
    ],
    'field_wrapper' => [
      '#type' => 'container',
      '#attributes' => ['id' => "field-wrapper-{$row_count}"],
    ],
    'transform' => [
      '#type' => 'select',
      '#options' => $transform_options,
      '#default_value' => $existing_mapping['transform'] ?? 'none',
    ],
    'required' => [
      '#type' => 'checkbox',
      '#default_value' => $existing_mapping['required'] ?? FALSE,
    ],
    'actions' => [
      '#type' => 'button',
      '#value' => t('Auto-map'),
      '#attributes' => [
        'class' => ['button--small'],
        'data-webform-field' => $element_key,
        'data-row-index' => $row_count,
      ],
    ],
    'webform_field_key' => [
      '#type' => 'value',
      '#value' => $element_key,
    ],
  ];
  
  // Load field options if entity is selected
  $selected_entity = $existing_mapping['entity'] ?? '';
  if (!empty($selected_entity) && !empty($entities)) {
    $field_options = dataverse_webform_get_entity_field_options($dataverse_config ?? [], $selected_entity);
    $form['third_party_settings']['dataverse_webform']['field_mapping_wrapper']['field_mappings']['table'][$row_count]['field_wrapper']['field'] = [
      '#type' => 'select',
      '#options' => $field_options,
      '#default_value' => $existing_mapping['field'] ?? '',
    ];
  } else {
    $form['third_party_settings']['dataverse_webform']['field_mapping_wrapper']['field_mappings']['table'][$row_count]['field_wrapper']['field'] = [
      '#type' => 'select',
      '#options' => ['' => t('- Select entity first -')],
      '#disabled' => TRUE,
    ];
  }
}

/**
 * Show appropriate messages for field mapping status.
 */
function dataverse_webform_show_field_mapping_messages(&$form, $entities, $dataverse_config) {
  if (empty($entities) && dataverse_webform_has_complete_config($dataverse_config)) {
    $form['third_party_settings']['dataverse_webform']['field_mapping_wrapper']['field_mappings']['info'] = [
      '#markup' => '<div class="messages messages--warning">' . t('Unable to load entities from Dataverse. Please check your configuration and test the connection.') . '</div>',
    ];
  } elseif (empty($entities)) {
    $form['third_party_settings']['dataverse_webform']['field_mapping_wrapper']['field_mappings']['info'] = [
      '#markup' => '<div class="messages messages--info">' . t('Complete the Azure AD and Dataverse configuration above, then test the connection to load available entities and fields.') . '</div>',
    ];
  }
}

/**
 * Log submission results with proper error handling.
 */
function dataverse_webform_log_submission_results($webform, $webform_submission, $results) {
  $logger = \Drupal::logger('dataverse_webform');
  
  foreach ($results as $entity_name => $result) {
    if ($result['success']) {
      $logger->info(
        'Successfully submitted webform @webform_id submission @submission_id to Dataverse entity @entity',
        [
          '@webform_id' => $webform->id(),
          '@submission_id' => $webform_submission->id(),
          '@entity' => $entity_name,
        ]
      );
    } else {
      $logger->error(
        'Failed to submit webform @webform_id submission @submission_id to Dataverse entity @entity: @error',
        [
          '@webform_id' => $webform->id(),
          '@submission_id' => $webform_submission->id(),
          '@entity' => $entity_name,
          '@error' => $result['error'] ?? 'Unknown error',
        ]
      );
    }
  }
}

/**
 * Check if Dataverse configuration is complete.
 */
function dataverse_webform_has_complete_config($config): bool {
  $required_fields = [
    'dataverse_url',
    'azure_tenant_id',
    'azure_client_id_key',
    'azure_client_secret_key',
  ];
  
  foreach ($required_fields as $field) {
    if (empty($config[$field])) {
      return FALSE;
    }
  }
  
  return TRUE;
}

/**
 * Get field options for a specific entity.
 */
function dataverse_webform_get_entity_field_options($config, $entity_name): array {
  static $field_cache = [];
  
  $cache_key = md5($entity_name . serialize($config));
  if (isset($field_cache[$cache_key])) {
    return $field_cache[$cache_key];
  }
  
  $field_options = ['' => t('- Select a field -')];
  
  try {
    $dataverse_service = \Drupal::service('dataverse_webform.dataverse_client');
    $fields = $dataverse_service->getEntityFields($config, $entity_name);
    
    foreach ($fields as $field) {
      $field_options[$field['logical_name']] = $field['display_name'] . ' (' . $field['logical_name'] . ')';
    }
  } catch (\Exception $e) {
    \Drupal::logger('dataverse_webform')->warning(
      'Failed to load fields for entity @entity: @error',
      ['@entity' => $entity_name, '@error' => $e->getMessage()]
    );
  }
  
  $field_cache[$cache_key] = $field_options;
  return $field_options;
}

/**
 * Ajax callback for test connection button.
 */
function dataverse_webform_test_connection_ajax_callback($form, FormStateInterface $form_state) {
  $config = [
    'enabled' => TRUE,
    'dataverse_url' => $form_state->getValue(['third_party_settings', 'dataverse_webform', 'dataverse_url']),
    'azure_tenant_id' => $form_state->getValue(['third_party_settings', 'dataverse_webform', 'azure_tenant_id']),
    'azure_client_id_key' => $form_state->getValue(['third_party_settings', 'dataverse_webform', 'azure_client_id_key']),
    'azure_client_secret_key' => $form_state->getValue(['third_party_settings', 'dataverse_webform', 'azure_client_secret_key']),
  ];
  
  try {
    $dataverse_service = \Drupal::service('dataverse_webform.dataverse_client');
    if ($dataverse_service->testConnection($config)) {
      \Drupal::messenger()->addStatus(t('✅ Connection successful! Entities loaded.'));
    } else {
      \Drupal::messenger()->addError(t('❌ Connection failed. Please check your configuration.'));
    }
  } catch (\Exception $e) {
    \Drupal::messenger()->addError(t('❌ Connection test failed: @error', ['@error' => $e->getMessage()]));
  }
  
  return $form['third_party_settings']['dataverse_webform']['field_mapping_wrapper'];
}

/**
 * Ajax callback for entity selection change.
 */
function dataverse_webform_entity_change_ajax_callback($form, FormStateInterface $form_state) {
  $triggering_element = $form_state->getTriggeringElement();
  $row_index = $triggering_element['#attributes']['data-row-index'];
  
  return $form['third_party_settings']['dataverse_webform']['field_mapping_wrapper']['field_mappings']['table'][$row_index]['field_wrapper'];
}

/**
 * Validation handler for webform admin form.
 */
function dataverse_webform_admin_form_validate($form, FormStateInterface $form_state) {
  $dataverse_settings = $form_state->getValue(['third_party_settings', 'dataverse_webform']);
  
  if (!empty($dataverse_settings['enabled'])) {
    try {
      $config_manager = \Drupal::service('dataverse_webform.config_manager');
      $validation_results = $config_manager->validateConfiguration($dataverse_settings);
      
      if (!$validation_results['valid']) {
        foreach ($validation_results['errors'] as $error) {
          $form_state->setErrorByName('third_party_settings][dataverse_webform', $error);
        }
      }
      
      // Test connection if validation passes
      if ($validation_results['valid']) {
        $dataverse_service = \Drupal::service('dataverse_webform.dataverse_client');
        if (!$dataverse_service->testConnection($dataverse_settings)) {
          $form_state->setErrorByName(
            'third_party_settings][dataverse_webform][dataverse_url',
            t('Failed to connect to Dataverse. Please verify your configuration.')
          );
        }
      }
      
    } catch (DataverseException $e) {
      $form_state->setErrorByName(
        'third_party_settings][dataverse_webform',
        t('Dataverse configuration error: @error', ['@error' => $e->getMessage()])
      );
    }
  }
}

/**
 * Custom submit handler for webform admin form.
 */
function dataverse_webform_admin_form_submit($form, FormStateInterface $form_state) {
  /** @var \Drupal\webform\WebformInterface $webform */
  $webform = $form_state->getFormObject()->getEntity();
  $dataverse_settings = $form_state->getValue(['third_party_settings', 'dataverse_webform']);
  
  // Process field mappings from table format to storage format
  if (!empty($dataverse_settings['field_mapping_wrapper']['field_mappings']['table'])) {
    $field_mappings = [];
    $table_data = $dataverse_settings['field_mapping_wrapper']['field_mappings']['table'];
    
    foreach ($table_data as $row_data) {
      if (!empty($row_data['webform_field_key']) && 
          !empty($row_data['entity']) && 
          !empty($row_data['field_wrapper']['field'])) {
        
        $field_mappings[] = [
          'webform_field' => $row_data['webform_field_key'],
          'entity' => $row_data['entity'],
          'field' => $row_data['field_wrapper']['field'],
          'transform' => $row_data['transform'] ?? 'none',
          'required' => !empty($row_data['required']),
          'relationship_to' => null, // Future enhancement
        ];
      }
    }
    
    $dataverse_settings['field_mappings'] = $field_mappings;
  }
  
  // Process submission order
  if (!empty($dataverse_settings['field_mapping_wrapper']['submission_order']['order'])) {
    $submission_order = array_filter($dataverse_settings['field_mapping_wrapper']['submission_order']['order']);
    $dataverse_settings['submission_order'] = array_values($submission_order);
  }
  
  // Clean up form-specific wrapper data
  unset($dataverse_settings['field_mapping_wrapper']);
  
  // Save the configuration
  $webform->setThirdPartySetting('dataverse_webform', 'dataverse_config', $dataverse_settings);
  $webform->save();
  
  if (!empty($dataverse_settings['enabled'])) {
    $entity_count = count($dataverse_settings['field_mappings'] ?? []);
    \Drupal::messenger()->addStatus(t('Dataverse integration has been configured successfully with @count field mappings.', [
      '@count' => $entity_count,
    ]));
  } else {
    \Drupal::messenger()->addStatus(t('Dataverse integration has been disabled.'));
  }
}

/**
 * Implements hook_theme().
 */
function dataverse_webform_theme() {
  return [
    'dataverse_webform_field_mapping_table' => [
      'variables' => [
        'mappings' => [],
        'entities' => [],
        'webform_fields' => [],
      ],
    ],
  ];
}

/**
 * Implements hook_help().
 */
function dataverse_webform_help($route_name, \Drupal\Core\Routing\RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.dataverse_webform':
      return '<p>' . t('The Dataverse Webform Integration module allows you to automatically submit webform data to Microsoft Dataverse. This enhanced version supports mapping individual fields to different entities within the same form.') . '</p>';
      
    case 'dataverse_webform.test':
      return '<p>' . t('Use this form to test your Dataverse connection and configuration. Ensure all settings are correct before enabling integration on your webforms.') . '</p>';
  }
  
  return '';
}

/**
 * Implements hook_requirements().
 */
function dataverse_webform_requirements($phase) {
  $requirements = [];

  if ($phase == 'runtime') {
    // Check if required services are available
    if (\Drupal::hasService('dataverse_webform.dataverse_client')) {
      $requirements['dataverse_webform_services'] = [
        'title' => t('Dataverse Webform Integration'),
        'value' => t('Services available'),
        'severity' => REQUIREMENT_OK,
      ];
    } else {
      $requirements['dataverse_webform_services'] = [
        'title' => t('Dataverse Webform Integration'),
        'value' => t('Services not available'),
        'description' => t('Dataverse integration services are not properly configured.'),
        'severity' => REQUIREMENT_ERROR,
      ];
    }
  }

  return $requirements;
}