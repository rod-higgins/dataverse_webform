<?php

/**
 * @file
 * Main module file for Dataverse Webform Integration with multi-entity support.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\webform\WebformSubmissionInterface;
use Drupal\Core\Ajax\AjaxResponse;
use Drupal\Core\Ajax\ReplaceCommand;
use Drupal\Core\Ajax\InvokeCommand;
use Drupal\dataverse_webform\Exception\DataverseException;

/**
 * Memory usage threshold for large form processing (128MB).
 */
const DATAVERSE_WEBFORM_MEMORY_THRESHOLD = 134217728;

/**
 * Implements hook_webform_submission_insert().
 */
function dataverse_webform_webform_submission_insert(WebformSubmissionInterface $webform_submission) {
  $webform = $webform_submission->getWebform();
  
  // Check if this webform has Dataverse integration enabled
  $dataverse_config = $webform->getThirdPartySetting('dataverse_webform', 'dataverse_config');
  
  if (!empty($dataverse_config['enabled'])) {
    try {
      $dataverse_service = \Drupal::service('dataverse_webform.dataverse_client');
      $results = $dataverse_service->submitToDataverse($webform_submission, $dataverse_config);
      
      // Log submission results
      dataverse_webform_log_submission_results($webform, $webform_submission, $results);
      
    } catch (\Exception $e) {
      \Drupal::logger('dataverse_webform')->error(
        'Failed to process Dataverse submission for webform @webform_id: @error',
        [
          '@webform_id' => $webform->id(),
          '@error' => $e->getMessage(),
        ]
      );
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for webform admin form.
 */
function dataverse_webform_form_webform_admin_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  /** @var \Drupal\webform\WebformInterface $webform */
  $webform = $form_state->getFormObject()->getEntity();
  
  // Get configuration manager service
  $config_manager = \Drupal::service('dataverse_webform.config_manager');
  
  // Build the main Dataverse integration section
  dataverse_webform_build_main_section($form, $webform, $config_manager);
  
  // Build configuration sections
  dataverse_webform_build_azure_config_section($form, $webform, $config_manager);
  dataverse_webform_build_dataverse_config_section($form, $webform);
  dataverse_webform_build_advanced_config_section($form, $webform);
  
  // Build field mapping section
  dataverse_webform_build_field_mapping_section($form, $form_state, $webform, $config_manager);
  
  // Add validation and submit handlers
  $form['#validate'][] = 'dataverse_webform_admin_form_validate';
  $form['actions']['submit']['#submit'][] = 'dataverse_webform_admin_form_submit';
  
  // Add JavaScript for dynamic field mapping
  $form['#attached']['library'][] = 'dataverse_webform/admin';
}

/**
 * Build the main Dataverse integration section.
 */
function dataverse_webform_build_main_section(&$form, $webform, $config_manager) {
  $dataverse_config = $webform->getThirdPartySetting('dataverse_webform', 'dataverse_config', []);
  $dataverse_config = $config_manager->mergeWithDefaults($dataverse_config);

  $form['third_party_settings']['dataverse_webform'] = [
    '#type' => 'details',
    '#title' => t('Dataverse Integration'),
    '#description' => t('Configure integration with Microsoft Dataverse. This enhanced version supports mapping fields to multiple entities.'),
    '#open' => TRUE,
    '#tree' => TRUE,
  ];
  
  $form['third_party_settings']['dataverse_webform']['enabled'] = [
    '#type' => 'checkbox',
    '#title' => t('Enable Dataverse integration'),
    '#description' => t('Enable automatic submission of webform data to Microsoft Dataverse.'),
    '#default_value' => $dataverse_config['enabled'] ?? FALSE,
  ];
}

/**
 * Build the Azure AD configuration section.
 */
function dataverse_webform_build_azure_config_section(&$form, $webform, $config_manager) {
  $dataverse_config = $webform->getThirdPartySetting('dataverse_webform', 'dataverse_config', []);
  $dataverse_config = $config_manager->mergeWithDefaults($dataverse_config);

  $form['third_party_settings']['dataverse_webform']['azure_config'] = [
    '#type' => 'details',
    '#title' => t('Azure AD Configuration'),
    '#description' => t('Configure Azure Active Directory authentication settings.'),
    '#open' => TRUE,
    '#states' => [
      'visible' => [
        ':input[name="third_party_settings[dataverse_webform][enabled]"]' => ['checked' => TRUE],
      ],
    ],
  ];
  
  // Get available keys for Azure AD credentials
  $key_options = $config_manager->getAzureCredentialKeys();
  
  $form['third_party_settings']['dataverse_webform']['azure_tenant_id'] = [
    '#type' => 'textfield',
    '#title' => t('Azure Tenant ID'),
    '#description' => t('Your Azure AD tenant ID (GUID format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)'),
    '#default_value' => $dataverse_config['azure_tenant_id'] ?? '',
    '#pattern' => '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}',
    '#attributes' => [
      'placeholder' => 'xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx',
    ],
    '#states' => [
      'required' => [
        ':input[name="third_party_settings[dataverse_webform][enabled]"]' => ['checked' => TRUE],
      ],
    ],
  ];
  
  $form['third_party_settings']['dataverse_webform']['azure_client_id_key'] = [
    '#type' => 'select',
    '#title' => t('Azure Client ID Key'),
    '#description' => t('Select the key containing your Azure AD application client ID. <a href="@url" target="_blank">Manage keys</a>.', [
      '@url' => \Drupal::url('entity.key.collection'),
    ]),
    '#options' => $key_options,
    '#default_value' => $dataverse_config['azure_client_id_key'] ?? '',
    '#states' => [
      'required' => [
        ':input[name="third_party_settings[dataverse_webform][enabled]"]' => ['checked' => TRUE],
      ],
    ],
  ];
  
  $form['third_party_settings']['dataverse_webform']['azure_client_secret_key'] = [
    '#type' => 'select',
    '#title' => t('Azure Client Secret Key'),
    '#description' => t('Select the key containing your Azure AD application client secret. <a href="@url" target="_blank">Manage keys</a>.', [
      '@url' => \Drupal::url('entity.key.collection'),
    ]),
    '#options' => $key_options,
    '#default_value' => $dataverse_config['azure_client_secret_key'] ?? '',
    '#states' => [
      'required' => [
        ':input[name="third_party_settings[dataverse_webform][enabled]"]' => ['checked' => TRUE],
      ],
    ],
  ];
}

