<?php

/**
 * @file
 * Install, update and uninstall functions for the Dataverse Webform module.
 */

/**
 * Implements hook_requirements().
 */
function dataverse_webform_requirements($phase) {
  $requirements = [];

  if ($phase === 'install') {
    $requirements += dataverse_webform_check_module_dependencies();
  }

  if ($phase === 'runtime') {
    $requirements += dataverse_webform_check_module_dependencies();
    $requirements += dataverse_webform_check_php_requirements();
    $requirements += dataverse_webform_check_webform_configurations();
  }

  return $requirements;
}

/**
 * Implements hook_install().
 */
function dataverse_webform_install() {
  $config = \Drupal::configFactory()->getEditable('dataverse_webform.settings');
  $config->setMultiple([
    'default_timeout' => 30,
    'default_batch_size' => 10,
    'default_retry_attempts' => 3,
    'cache_entity_metadata_hours' => 1,
    'rate_limit_requests_per_hour' => 100,
    'rate_limit_enabled' => true,
  ])->save();
  
  \Drupal::messenger()->addStatus(t('Dataverse Webform Integration module installed successfully. Configure your Azure AD credentials using the <a href="@url">Key module</a>.', [
    '@url' => \Drupal::url('entity.key.collection'),
  ]));
}

/**
 * Implements hook_uninstall().
 */
function dataverse_webform_uninstall() {
  dataverse_webform_clean_webform_settings();
  dataverse_webform_clean_cache_and_state();
  
  \Drupal::configFactory()->getEditable('dataverse_webform.settings')->delete();
  
  \Drupal::messenger()->addStatus(t('Dataverse Webform Integration module uninstalled. All configuration and cached data removed.'));
}

/**
 * Update 8001: Convert legacy configurations to multi-entity format.
 */
function dataverse_webform_update_8001() {
  $config_manager = \Drupal::service('dataverse_webform.config_manager');
  $webforms = \Drupal::entityTypeManager()->getStorage('webform')->loadMultiple();
  $converted_count = 0;
  
  foreach ($webforms as $webform) {
    $dataverse_config = $webform->getThirdPartySetting('dataverse_webform', 'dataverse_config');
    
    if (dataverse_webform_is_legacy_config($dataverse_config)) {
      $new_config = $config_manager->convertLegacyConfiguration($dataverse_config);
      $webform->setThirdPartySetting('dataverse_webform', 'dataverse_config', $new_config);
      $webform->save();
      $converted_count++;
    }
  }
  
  return t('Converted @count webform(s) from legacy configuration format.', ['@count' => $converted_count]);
}

/**
 * Update 8002: Add default advanced configuration settings.
 */
function dataverse_webform_update_8002() {
  $webforms = \Drupal::entityTypeManager()->getStorage('webform')->loadMultiple();
  $updated_count = 0;
  
  foreach ($webforms as $webform) {
    $dataverse_config = $webform->getThirdPartySetting('dataverse_webform', 'dataverse_config');
    
    if (!empty($dataverse_config['enabled'])) {
      $defaults = [
        'batch_size' => 10,
        'retry_attempts' => 3,
        'timeout' => 30,
        'stop_on_error' => true,
      ];
      
      $updated = false;
      foreach ($defaults as $key => $default_value) {
        if (!isset($dataverse_config[$key])) {
          $dataverse_config[$key] = $default_value;
          $updated = true;
        }
      }
      
      if ($updated) {
        $webform->setThirdPartySetting('dataverse_webform', 'dataverse_config', $dataverse_config);
        $webform->save();
        $updated_count++;
      }
    }
  }
  
  return t('Updated @count webform(s) with advanced configuration settings.', ['@count' => $updated_count]);
}

/**
 * Update 8003: Clear cached metadata.
 */
function dataverse_webform_update_8003() {
  \Drupal::cache('default')->invalidateAll();
  \Drupal::service('cache_tags.invalidator')->invalidateTags(['dataverse_webform']);
  
  return t('Cleared cached Dataverse metadata entries.');
}

/**
 * Update 8004: Validate and repair field mappings.
 */
function dataverse_webform_update_8004() {
  $webforms = \Drupal::entityTypeManager()->getStorage('webform')->loadMultiple();
  $repaired_count = 0;
  $issues = [];
  
  foreach ($webforms as $webform) {
    $dataverse_config = $webform->getThirdPartySetting('dataverse_webform', 'dataverse_config');
    
    if (!empty($dataverse_config['field_mappings'])) {
      $webform_elements = $webform->getElementsInitializedAndFlattened();
      $original_count = count($dataverse_config['field_mappings']);
      
      $dataverse_config['field_mappings'] = array_filter(
        $dataverse_config['field_mappings'],
        function($mapping) use ($webform_elements, &$issues, $webform) {
          if (!isset($webform_elements[$mapping['webform_field']])) {
            $issues[] = "Webform {$webform->id()}: field '{$mapping['webform_field']}' no longer exists";
            return false;
          }
          return true;
        }
      );
      
      if (count($dataverse_config['field_mappings']) !== $original_count) {
        $webform->setThirdPartySetting('dataverse_webform', 'dataverse_config', $dataverse_config);
        $webform->save();
        $repaired_count++;
      }
    }
  }
  
  $message = t('Validated and repaired field mappings for @count webform(s).', ['@count' => $repaired_count]);
  if (!empty($issues)) {
    $message .= ' Issues found: ' . implode('; ', $issues);
  }
  
  return $message;
}

/**
 * Update 8005: Initialize performance improvements.
 */
function dataverse_webform_update_8005() {
  $config = \Drupal::configFactory()->getEditable('dataverse_webform.settings');
  $config->setMultiple([
    'rate_limit_requests_per_hour' => 100,
    'rate_limit_enabled' => true,
    'cache_tags_enabled' => true,
  ])->save();
  
  \Drupal::cache('default')->invalidateTags(['dataverse_webform']);
  
  return t('Initialized rate limiting and performance improvements.');
}

/**
 * Check module dependencies.
 */
function dataverse_webform_check_module_dependencies(): array {
  $requirements = [];
  $module_handler = \Drupal::service('module_handler');
  
  $required_modules = [
    'webform' => 'Webform module required',
    'key' => 'Key module required for secure credential storage',
  ];
  
  foreach ($required_modules as $module => $description) {
    if (!$module_handler->moduleExists($module)) {
      $requirements["dataverse_webform_{$module}"] = [
        'title' => t('Dataverse Webform Integration'),
        'value' => t('@description', ['@description' => $description]),
        'severity' => REQUIREMENT_ERROR,
      ];
    }
  }
  
  return $requirements;
}

/**
 * Check PHP requirements.
 */
function dataverse_webform_check_php_requirements(): array {
  $requirements = [];
  
  $php_checks = [
    ['curl_init', 'cURL not available', 'cURL is required for HTTP communication', REQUIREMENT_ERROR],
    ['openssl_encrypt', 'OpenSSL extension not available', 'OpenSSL is required for secure communication', REQUIREMENT_ERROR],
    ['json_encode', 'JSON extension not available', 'JSON extension is required for API communication', REQUIREMENT_ERROR],
  ];
  
  foreach ($php_checks as [$function, $title, $description, $severity]) {
    if (!function_exists($function)) {
      $requirements['dataverse_webform_' . str_replace('_', '', $function)] = [
        'title' => t('Dataverse Webform Integration'),
        'value' => t($title),
        'description' => t($description),
        'severity' => $severity,
      ];
    }
  }
  
  if (version_compare(PHP_VERSION, '7.4', '<')) {
    $requirements['dataverse_webform_php'] = [
      'title' => t('Dataverse Webform Integration'),
      'value' => t('PHP version too old'),
      'description' => t('PHP 7.4+ is recommended for optimal performance.'),
      'severity' => REQUIREMENT_WARNING,
    ];
  }
  
  return $requirements;
}

/**
 * Check webform configurations.
 */
function dataverse_webform_check_webform_configurations(): array {
  $requirements = [];
  
  $configured_webforms = dataverse_webform_get_configured_webforms();
  if (!empty($configured_webforms)) {
    $count = count($configured_webforms);
    $requirements['dataverse_webform_configured'] = [
      'title' => t('Dataverse Webform Integration'),
      'value' => t('@count webform(s) configured', ['@count' => $count]),
      'description' => t('Dataverse integration is active on: @forms', [
        '@forms' => implode(', ', array_keys($configured_webforms)),
      ]),
      'severity' => REQUIREMENT_INFO,
    ];
  }
  
  $config_issues = dataverse_webform_check_configuration_issues();
  if (!empty($config_issues)) {
    $requirements['dataverse_webform_config_issues'] = [
      'title' => t('Dataverse Webform Integration'),
      'value' => t('Configuration issues detected'),
      'description' => t('Issues found: @issues', ['@issues' => implode(', ', $config_issues)]),
      'severity' => REQUIREMENT_WARNING,
    ];
  }
  
  return $requirements;
}

/**
 * Get webforms configured with Dataverse integration.
 */
function dataverse_webform_get_configured_webforms(): array {
  $webforms = \Drupal::entityTypeManager()->getStorage('webform')->loadMultiple();
  $configured_webforms = [];
  
  foreach ($webforms as $webform) {
    $dataverse_config = $webform->getThirdPartySetting('dataverse_webform', 'dataverse_config');
    if (!empty($dataverse_config['enabled'])) {
      $configured_webforms[$webform->id()] = $webform->label();
    }
  }
  
  return $configured_webforms;
}

/**
 * Check for configuration issues across all webforms.
 */
function dataverse_webform_check_configuration_issues(): array {
  $issues = [];
  $webforms = \Drupal::entityTypeManager()->getStorage('webform')->loadMultiple();
  
  foreach ($webforms as $webform) {
    $dataverse_config = $webform->getThirdPartySetting('dataverse_webform', 'dataverse_config');
    
    if (!empty($dataverse_config['enabled'])) {
      $issues = array_merge($issues, dataverse_webform_validate_webform_config($webform, $dataverse_config));
    }
  }
  
  return $issues;
}

/**
 * Validate webform configuration.
 */
function dataverse_webform_validate_webform_config($webform, array $config): array {
  $issues = [];
  $webform_id = $webform->id();
  
  $required_fields = ['azure_tenant_id', 'azure_client_id_key', 'azure_client_secret_key', 'dataverse_url'];
  foreach ($required_fields as $field) {
    if (empty($config[$field])) {
      $issues[] = "Webform {$webform_id}: missing {$field}";
    }
  }
  
  if (empty($config['field_mappings'])) {
    $issues[] = "Webform {$webform_id}: no field mappings configured";
  }
  
  $key_repository = \Drupal::service('key.repository');
  foreach (['azure_client_id_key', 'azure_client_secret_key'] as $key_field) {
    if (!empty($config[$key_field]) && !$key_repository->getKey($config[$key_field])) {
      $issues[] = "Webform {$webform_id}: {$key_field} not found";
    }
  }
  
  return $issues;
}

/**
 * Check if configuration is legacy format.
 */
function dataverse_webform_is_legacy_config(array $config): bool {
  return !empty($config['target_entity']) && 
         !empty($config['field_mapping']) && 
         empty($config['field_mappings']);
}

/**
 * Clean webform third-party settings.
 */
function dataverse_webform_clean_webform_settings(): void {
  $webforms = \Drupal::entityTypeManager()->getStorage('webform')->loadMultiple();
  
  foreach ($webforms as $webform) {
    if ($webform->getThirdPartySetting('dataverse_webform', 'dataverse_config')) {
      $webform->unsetThirdPartySetting('dataverse_webform', 'dataverse_config');
      $webform->save();
    }
  }
}

/**
 * Clean cache and state entries.
 */
function dataverse_webform_clean_cache_and_state(): void {
  \Drupal::cache('default')->invalidateTags(['dataverse_webform']);
  
  $state = \Drupal::state();
  $state_keys = $state->getMultiple([]);
  foreach ($state_keys as $key => $value) {
    if (strpos($key, 'dataverse_webform.') === 0) {
      $state->delete($key);
    }
  }
}